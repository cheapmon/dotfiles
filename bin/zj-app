#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/zj-switch"

declare -a paths
declare -A apps

# Check environment
if [[ ! -v ZJ_APP_DIR ]]; then
  exit 1
fi

# Build apps list
if [[ -d "${ZJ_APP_DIR}" ]]; then
  for d in "${ZJ_APP_DIR}"/*; do
    [[ -d "$d" ]] && paths+=("$d")
  done
fi

for path in "${paths[@]}"; do
  b=$(basename "$path")
  apps[$b]=$path
done

# Select app
app=$(printf '%s\n' "${!apps[@]}" | sort | fzf --prompt "app " --style full) || exit 0
path="${apps[$app]}"

# App-specific layout and init live in a subfolder so zj-session does not list them
app_dir=~/.config/zellij/layouts/apps
layout="app"
# Absolute path without .kdl: zellij-switch appends the extension itself
[[ -f "$app_dir/$app.kdl" ]] && layout="$app_dir/$app"

# Run init only for a new session
if ! zj_session_exists "$app" && [[ -x "$app_dir/$app.init" ]]; then
  (cd "$path" && "$app_dir/$app.init")
fi

zj_switch "$app" "$path" "$layout"
