@import "mocha.css";

* {
  font-family: IosevkaTerm Nerd Font;
  font-size: 13px;
  min-height: 0;
}

#waybar {
  background: transparent;
  color: @text;
  margin: 5px 5px;
}

#workspaces {
  border-radius: 1rem;
  margin: 5px;
  background-color: @surface0;
  margin-left: 1rem;
}

#workspaces button {
  color: @lavender;
  border-radius: 1rem;
  padding: 0.4rem;
}

#workspaces button.active {
  color: @sky;
  border-radius: 1rem;
}

#workspaces button:hover {
  color: @sapphire;
  border-radius: 1rem;
}

#window,
#submap,
#battery,
#backlight,
#pulseaudio,
#clock,
#tray {
  background-color: @surface0;
  padding: 0.5rem 1rem;
  margin: 5px 0;
}

#window,
#submap {
  border-radius: 1rem;
}

#window {
  margin-right: 1rem;
}

#submap.hypr {
  background-color: @red;
  color: @surface0;
}

#submap.move,
#submap.resize {
  background-color: @peach;
  color: @surface0;
}

#battery {
  color: @yellow;
  margin-left: 1rem;
  border-radius: 1rem 0px 0px 1rem;
}

#backlight {
  color: @lavender;
}

#pulseaudio {
  color: @maroon;
  {%- if desktop %}
  margin-left: 1rem;
  border-radius: 1rem 0px 0px 1rem;
  {% endif -%}
}

#clock {
  color: @blue;
  border-radius: 0px 1rem 1rem 0px;
  margin-right: 1rem;
}

#tray {
  margin-right: 1rem;
  border-radius: 1rem;
}
